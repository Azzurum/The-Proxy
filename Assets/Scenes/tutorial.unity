  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialDialogueTrigger
  dialogueEngine: {fileID: 1736529083}
  introductionConversation:
  - speakerName: Kaelen
    dialogueText: '*Hiss... Click.* Pressure seal released. Finally...'
  - speakerName: Kaelen
    dialogueText: I swear, this survival suit gets heavier with every sector jump.
      It feels incredible to finally stretch my arms without hitting a bulkhead.
  - speakerName: Kaelen
    dialogueText: Alright, enough resting. Let's initialize the local AetherCore
      terminal and see what state this station left its systems in.
