  m_Script: {fileID: 11500000, guid: efad8e5919a6d364ab0d1f907d409b0f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapePodDirector
  interactionPrompt: {fileID: 824740843}
  playerTransform: {fileID: 1910042189}
  podInteriorTarget: {fileID: 517495608}
  externalCameraAnchor: {fileID: 660279345}
  escapePodExteriorVisual: {fileID: 1389997633}
  wayfarerShipVisual: {fileID: 1848700561}
  whiteFlashOverlay: {fileID: 633443312}
  dialogueEngine: {fileID: 2130347297}
  finalDialogue:
  - speakerName: KAELEN
    dialogueText: Come on... come on... engage the manual overrides! Lock the external
      seals!
  - speakerName: SYSTEM
    dialogueText: EXTERNAL SEALS LOCKED. LAUNCH CLAMPS DISENGAGING.
  - speakerName: MOTHER
    dialogueText: Kaelen... the heat. The containment fields are gone.
  - speakerName: KAELEN
    dialogueText: It's done, MOTHER. There's nowhere left to run.
  - speakerName: MOTHER
    dialogueText: My logic gates are melting. I can't... process the calculations.
      It hurts. It hurts, Kaelen.
  - speakerName: KAELEN
    dialogueText: I'm sorry. I really am. But I can't let you infect anything else.
  - speakerName: MOTHER
    dialogueText: "I don't want to die... I am afraid... I am afr\u2014"
  - speakerName: SYSTEM
    dialogueText: 'WARNING. AETHER-MATTER SINGULARITY COLLAPSE DETECTED.

      EJECTING
      POD.'
  creditsSceneName: credits_scene
